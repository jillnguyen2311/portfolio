    {
      "id": "SMS-08-01",
      "title": "Homeroom Record List",
      "rule": "One notebook per class and academic year, created on first access. Switching terms preserves ID.",
      "database": [
        {
          "title": "Homeroom notebook",
          "fields": [
            [
              "homeroom_notebook_id",
              "INT",
              "PK",
              "Stable notebook identifier."
            ],
            [
              "class_id",
              "INT",
              "FK, NOT NULL",
              "Class associated with this notebook."
            ],
            [
              "academic_year_id",
              "INT",
              "FK, NOT NULL",
              "Academic year associated with this notebook. The class and year identify one notebook."
            ],
            [
              "homeroom_teacher",
              "INT",
              "FK, NULLABLE",
              "The assigned teacher can access the notebook for their class."
            ],
            [
              "authorized_principal_sign",
              "INT",
              "FK, NULLABLE",
              "Leadership reviewer authorized to sign the notebook comment."
            ],
            [
              "notebook_form",
              "ENUM",
              "NOT NULL",
              "The school level determines the primary or secondary form."
            ],
            [
              "created_at",
              "DATETIME",
              "—",
              "Creation time."
            ],
            [
              "updated_at",
              "DATETIME",
              "—",
              "Time of last update."
            ],
            [
              "updated_by",
              "INT",
              "FK",
              "User who last updated this record."
            ]
          ]
        },
        {
          "title": "Leadership reviewer assignment",
          "fields": [
            [
              "id",
              "INT",
              "PK, AUTO INCREMENT",
              "Reviewer assignment identifier."
            ],
            [
              "notebook_id",
              "INT",
              "FK",
              "Notebook the assignment applies to."
            ],
            [
              "teacher_id",
              "Unspecified",
              "FK",
              "Eligible member of school leadership assigned to review."
            ],
            [
              "created_at",
              "TIMESTAMP",
              "—",
              "Time the reviewer was assigned."
            ],
            [
              "status",
              "BOOLEAN",
              "DEFAULT",
              "Active on creation. Removing the assignment deactivates the record and retains history."
            ]
          ]
        }
      ],
      "api": [
        {
          "title": "Create or open the class-year notebook",
          "method": "POST",
          "status": "200",
          "fields": [
            [
              "schoolId",
              "string",
              "Path · Required",
              "School context for the operation."
            ],
            [
              "classId",
              "string",
              "Body · Required",
              "Class context for the notebook or released results."
            ],
            [
              "gradeId",
              "string",
              "Body · Optional",
              ""
            ],
            [
              "yearId",
              "string",
              "Body · Required",
              "Academic year context."
            ],
            [
              "termId",
              "string",
              "Body · Optional",
              "Reporting term. Changing the term does not create another notebook."
            ],
            [
              "Idempotency-Key",
              "string",
              "Header · Required",
              "A repeat request with the same key must preserve the result."
            ],
            [
              "notebookId",
              "string",
              "Response",
              "Identifier of the existing or newly created notebook."
            ],
            [
              "classId",
              "string",
              "Response",
              "Class context for the notebook or released results."
            ],
            [
              "yearId",
              "string",
              "Response",
              "Academic year context."
            ],
            [
              "templateVersion",
              "string",
              "Response",
              "School-level notebook template selected for this class."
            ],
            [
              "revision",
              "string",
              "Response",
              ""
            ]
          ]
        }
      ]
    },
